# Starship prompt, One Dark palette (same as Ghostty, fish, bat and fzf).
# Line 1: where you are on the left, the context on the right ($fill pushes it there);
# line 2: the input. One Starship call per prompt: no right_format (see conf.d/10-tools.fish).
# Chain of coloured groups, / slants between, rounded ends:
# machine, folder, git, environment | cloud, tools, time.
# Groups that may be empty (git, environment, tools) sit in ( ), so Starship drops them with their
# separator, which takes its colour from what comes before it (prev_bg): no empty sliver.
# Icons are written as \u escapes: Nerd Font characters can be lost when the file is edited.
# Previous prompts: themes/classic.toml (p10k style), themes/*.toml (prompt-theme).
#
# Language versions: not Starship's modules (each runs `<tool> --version` on every prompt through
# the mise shims: node +137 ms, go +50 to +508 ms) but PROMPT_TOOLS, the versions declared for
# mise, read by fish on directory change (conf.d/20-prompt-tools.fish): no cost per prompt.

# Theme chosen with the `theme` fish function (chezmoi data, see .chezmoidata.toml).
palette = "{{ .theme }}"
format = """
[\ue0b6](machine)\
$os$username$hostname$container\
[\ue0bc](fg:machine bg:folder)\
$directory\
([\ue0bc](fg:prev_bg bg:git)$git_branch$git_status$git_state$git_metrics)\
([\ue0bc](fg:prev_bg bg:env)$python$terraform$direnv)\
[\ue0b4](fg:prev_bg)\
$fill\
$status$cmd_duration$jobs$sudo$shlvl\
[\ue0b6](fg:cloud)\
$gcloud$kubernetes$aws\
([\ue0be](fg:tools bg:prev_bg)${env_var.PROMPT_TOOLS}$package)\
[\ue0be](fg:time bg:prev_bg)\
$time\
[\ue0b4](fg:time)
$character"""

[fill]
symbol = " "

# --- Machine -----------------------------------------------------------------------------------
[os]
disabled = false
format = "[ $symbol]($style)"
style = "fg:machine_fg bg:machine"

[os.symbols]
Macos = "\U000f0035 "
Linux = "\U000f033d "
Ubuntu = "\U000f0548 "
Debian = "\U000f08da "
Fedora = "\U000f08db "

# user@host: over SSH only (and as root)
[username]
format = "[ $user]($style)"
style_user = "fg:machine_fg bg:machine"
style_root = "bold fg:machine_fg bg:machine"

[hostname]
ssh_only = true
format = "[@$hostname ]($style)"
style = "fg:machine_fg bg:machine"

[container]
format = "[ \uf4b7 $name ]($style)"
style = "fg:machine_fg bg:machine"

# --- Folder ------------------------------------------------------------------------------------
[directory]
format = "[ $path$read_only ]($style)"
style = "fg:folder_fg bg:folder"
read_only = " \U000f033e"
read_only_style = "fg:folder_fg bg:folder"
truncation_length = 4
truncate_to_repo = false
truncation_symbol = "…/"

# --- Git ---------------------------------------------------------------------------------------
[git_branch]
symbol = "\U000f062c"
format = "[ $symbol $branch ](fg:git_fg bg:git)"

# Counts (!2 ?1 ⇣3). ✓ = in sync with the upstream branch (Starship has no "clean worktree" state).
[git_status]
format = "([$all_status$ahead_behind](fg:git_fg bg:git))"
conflicted = "=${count} "
stashed = "\\$${count} "
deleted = "✘${count} "
renamed = "»${count} "
modified = "!${count} "
staged = "+${count} "
untracked = "?${count} "
ahead = "⇡${count} "
behind = "⇣${count} "
diverged = "⇕⇡${ahead_count}⇣${behind_count} "
up_to_date = "✓ "
# The git binary (direct, see conf.d/00-env.fish) is much faster than Starship's built-in
# library here: 29 ms vs 50 ms for the whole prompt (measured on a mid-sized repo).
use_git_executable = true

[git_state]
format = "[$state( $progress_current/$progress_total) ](fg:git_fg bg:git)"

[git_metrics]
disabled = false
format = "([+$added ]($added_style))([−$deleted ]($deleted_style))"
added_style = "fg:git_fg bg:git"
deleted_style = "fg:git_fg bg:git"

# --- Environment -------------------------------------------------------------------------------
# Python: only when a virtual environment is active
[python]
symbol = "\ue606"
detect_extensions = []
detect_files = []
format = "[ $symbol $virtualenv ](fg:env_fg bg:env)"

[terraform]
symbol = "\U000f1062"
format = "[ $symbol $workspace ](fg:env_fg bg:env)"

[direnv]
disabled = false
format = "[ $symbol$loaded ](fg:env_fg bg:env)"
symbol = "\uf462 "
loaded_msg = "loaded"
unloaded_msg = ""

# --- State, plain text before the right-hand chain ---------------------------------------------
[status]
disabled = false
format = "[✘ $status( $signal_name)](bold fg:error) "

# Duration shown above 1 s
[cmd_duration]
min_time = 1000
show_milliseconds = false
format = "[\uf252 $duration](fg:muted) "

[jobs]
symbol = "✦"
format = "[$symbol$number](fg:warning) "

[sudo]
disabled = false
format = "[$symbol](fg:warning) "
symbol = "\U000f0483 sudo"

# Nested shell: from 2 levels
[shlvl]
disabled = false
threshold = 2
format = "[$symbol$shlvl](fg:muted) "
symbol = "\uf120 "

# --- Cloud -------------------------------------------------------------------------------------
# gcloud: project only
[gcloud]
symbol = "\U000f11f6"
format = "[ $symbol $project ](fg:cloud_fg bg:cloud)"

[kubernetes]
disabled = false
symbol = "\U000f10fe"
format = "[ $symbol $context( \\($namespace\\)) ](fg:cloud_fg bg:cloud)"

[aws]
symbol = "\ue7ad"
format = "[ $symbol $profile ](fg:cloud_fg bg:cloud)"

# --- Tools -------------------------------------------------------------------------------------
# Versions declared for mise (node, go, python, terraform…), see conf.d/20-prompt-tools.fish
[env_var.PROMPT_TOOLS]
variable = "PROMPT_TOOLS"
format = "[ $env_value ](fg:tools_fg bg:tools)"

# Private packages too (display_private): most project package.json are private.
[package]
display_private = true
symbol = "\U000f03d7"
format = "[ $symbol $version ](fg:tools_fg bg:tools)"

# --- Time --------------------------------------------------------------------------------------
[time]
disabled = false
time_format = "%R"
format = "[ \uf43a $time ](fg:time_fg bg:time)"

[character]
success_symbol = "[›](bold fg:ok)"
error_symbol = "[›](bold fg:error)"

# One palette per theme, by role: <group> is the segment background, <group>_fg its text.
[palettes.one-dark]
machine = "#e06c75"
folder = "#d19a66"
git = "#e5c07b"
env = "#98c379"
cloud = "#56b6c2"
tools = "#c678dd"
time = "#61afef"
machine_fg = "#282c34"
folder_fg = "#282c34"
git_fg = "#282c34"
env_fg = "#282c34"
cloud_fg = "#282c34"
tools_fg = "#282c34"
time_fg = "#282c34"
error = "#e06c75"
warning = "#e5c07b"
ok = "#98c379"
muted = "#5c6370"

# Catppuccin Mocha, muted backgrounds: three surface greys in turn (neighbouring groups always
# differ, whichever optional group is missing) and the accent colour on the text.
[palettes.mocha-muted]
machine = "#313244"
folder = "#45475a"
git = "#585b70"
env = "#313244"
cloud = "#313244"
tools = "#45475a"
time = "#585b70"
machine_fg = "#f38ba8"
folder_fg = "#fab387"
git_fg = "#f9e2af"
env_fg = "#a6e3a1"
cloud_fg = "#74c7ec"
tools_fg = "#cba6f7"
time_fg = "#b4befe"
error = "#f38ba8"
warning = "#f9e2af"
ok = "#a6e3a1"
muted = "#7f849c"
