#!/bin/bash
# Installs the fish plugins listed in ~/.config/fish/fish_plugins (and removes the ones taken
# out of it). Runs after the Brewfile script, which installs fish and Fisher.
# fish_plugins: {{ include "dot_config/private_fish/fish_plugins" | sha256sum }}
set -euo pipefail

if ! command -v fish >/dev/null 2>&1; then
    echo "fish is missing: run 'chezmoi apply' again once the Brewfile is installed." >&2
    exit 1
fi

# </dev/null: without a terminal, Fisher reads the plugin list from stdin instead of the file.
fish -c 'fisher update' </dev/null
